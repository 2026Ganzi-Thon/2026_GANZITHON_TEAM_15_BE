# 복사해서 .env 로 사용하세요. .env 는 커밋하지 않습니다.
DB_NAME=teolhanol
DB_USERNAME=teolhanol
DB_PASSWORD=teolhanol
DB_ROOT_PASSWORD=root
DB_PORT=3307
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 민감정보 암호화 키 (Base64 32바이트). 생성: openssl rand -base64 32
# 로컬은 비워 두면 application-local.yml의 개발용 키를 씁니다.
APP_CRYPTO_KEY=

# Claude API 키. 비워 두면 LLM 기능 없이 시작하고 분류는 키워드 판정으로 대체됩니다.
ANTHROPIC_API_KEY=
