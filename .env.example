# 복사해서 .env 로 사용하세요. .env 는 커밋하지 않습니다.
DB_NAME=teolhanol
DB_USERNAME=teolhanol
DB_PASSWORD=teolhanol
DB_ROOT_PASSWORD=root
DB_PORT=3307
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 민감정보 암호화 키 (Base64 32바이트). 생성: openssl rand -base64 32
# 로컬은 비워 두면 application-local.yml의 개발용 키를 씁니다.
APP_CRYPTO_KEY=

# JWT 서명 키(32바이트 이상). 로컬은 비워 두면 개발용 키를 씁니다. 생성: openssl rand -base64 48
APP_JWT_SECRET=

# LLM 키. 둘 다 비워 두면 LLM 기능 없이 시작하고 분류는 키워드 판정으로 대체됩니다.
# 기본(auto)은 UPSTAGE_API_KEY가 있으면 Upstage Solar Pro 4, 없으면 ANTHROPIC_API_KEY의 Claude를 씁니다.
UPSTAGE_API_KEY=
ANTHROPIC_API_KEY=
# auto / upstage / claude
LLM_PROVIDER=auto

# 웹 푸시(털 도착 알림) VAPID 키. 비워 두면 웹 푸시만 꺼지고 구독 저장과 앱 안 알림(SSE)은 동작합니다(운영도 선택).
# 생성: npx web-push generate-vapid-keys  → Public Key / Private Key(base64url)를 그대로 넣습니다.
# 키를 바꾸면 기존 브라우저 구독은 쓸 수 없게 되어 프론트가 다시 구독해야 합니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 연락처(mailto: 또는 https: 주소). Safari(Apple) 푸시는 이 값이 있어야 합니다. 예) mailto:team@example.com
VAPID_SUBJECT=
